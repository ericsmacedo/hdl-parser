{
  "path": "$PRJ/examples/sv/macros/reg_macros.sv",
  "modules": [
    {
      "name": "reg_macros",
      "params": [
        {
          "ptype": "int",
          "name": "WIDTH",
          "default": "8"
        },
        {
          "ptype": "int",
          "name": "STAGES",
          "default": "3"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_i",
          "comment": [
            "Clock"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_ni",
          "comment": [
            "Reset, low active"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "d_i",
          "dim": "[WIDTH-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "q_o",
          "dim": "[WIDTH-1:0]"
        }
      ],
      "insts": [
        {
          "name": "u_delay",
          "module": "delay",
          "connections": [
            {
              "port": "clk_i",
              "con": "clk_i"
            },
            {
              "port": "rst_ni",
              "con": "rst_ni"
            },
            {
              "port": "d_i",
              "con": "stage_q"
            },
            {
              "port": "q_o"
            }
          ]
        }
      ]
    }
  ]
}