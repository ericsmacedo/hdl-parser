{
  "path": "$PRJ/examples/sv/macros/nonansi_ports.sv",
  "modules": [
    {
      "name": "nonansi_ports",
      "params": [
        {
          "name": "WIDTH",
          "default": "8"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "wire",
          "name": "clk",
          "dim": "[1-1:0]"
        },
        {
          "direction": "input",
          "ptype": "wire",
          "name": "rst_n",
          "dim": "[1-1:0]"
        },
        {
          "direction": "input",
          "ptype": "wire",
          "name": "cmd",
          "dim": "[WIDTH-1:0]"
        },
        {
          "direction": "input",
          "ptype": "wire",
          "name": "cmd_req",
          "dim": "[1-1:0]"
        },
        {
          "direction": "output",
          "ptype": "reg",
          "name": "cmd_ack",
          "dim": "[1-1:0]"
        },
        {
          "direction": "output",
          "ptype": "reg",
          "name": "rsp",
          "dim": "[2*WIDTH-1:0]"
        },
        {
          "direction": "input",
          "ptype": "wire",
          "name": "rsp_req",
          "dim": "[1-1:0]"
        },
        {
          "direction": "output",
          "ptype": "reg",
          "name": "rsp_ack",
          "dim": "[1-1:0]"
        }
      ]
    }
  ]
}