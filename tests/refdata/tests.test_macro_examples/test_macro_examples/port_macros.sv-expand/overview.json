        {
          "direction": "input",
          "ptype": "logic",
          "name": "cfg_pwdata_i",
          "dim": "[31:0]",
          "comment": [
            "Write Data"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "cfg_prdata_o",
          "dim": "[31:0]",
          "comment": [
            "Read Data"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "cfg_pready_o",
          "comment": [
            "Ready"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "busy_o",
          "comment": [
            "Busy"
          ]
        }
      ]
    }
  ]
