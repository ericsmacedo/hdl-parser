          "name": "OUT_WIDTH",
          "default": "8"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_i",
          "comment": [
            "Clock"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_ni",
          "comment": [
            "Reset, low active"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "in_valid"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "in_data",
          "dim": "[(IN_WIDTH)-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "in_ready"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "out_valid"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "out_data",
          "dim": "[(OUT_WIDTH)-1:0]"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "out_ready"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "aux_valid"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "aux_data",
          "dim": "[(8)-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "aux_ready"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "cfg_psel_i",
          "comment": [
            "Select"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "cfg_penable_i",
          "comment": [
            "Enable"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "cfg_pwrite_i",
          "comment": [
            "Write"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "cfg_paddr_i",
          "dim": "[(12)-1:0]",
