{
  "path": "$PRJ/tests/corpus/opentitan/prim_packer.sv",
  "modules": [
    {
      "name": "prim_packer",
      "params": [
        {
          "ptype": "unsigned",
          "name": "InW",
          "default": "32"
        },
        {
          "ptype": "unsigned",
          "name": "OutW",
          "default": "32",
          "comment": [
            "If 1, The input/output are byte granularity"
          ]
        },
        {
          "ptype": "int",
          "name": "HintByteData",
          "default": "0",
          "comment": [
            "Turn on protect against FI for the pos variable"
          ]
        },
        {
          "ptype": "bit",
          "name": "EnProtection",
          "default": "1'b 0"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "name": "clk_i"
        },
        {
          "direction": "input",
          "name": "rst_ni"
        },
        {
          "direction": "input",
          "name": "valid_i"
        },
        {
          "direction": "input",
          "name": "data_i",
          "dim": "[InW-1:0]"
        },
        {
          "direction": "input",
          "name": "mask_i",
          "dim": "[InW-1:0]"
        },
        {
          "direction": "output",
          "name": "ready_o"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "valid_o"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "data_o",
          "dim": "[OutW-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "mask_o",
          "dim": "[OutW-1:0]"
        },
        {
          "direction": "input",
          "name": "ready_i"
        },
        {
          "direction": "input",
          "name": "flush_i",
          "comment": [
            "If 1, send out remnant and clear state"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "flush_done_o",
          "comment": [
            "When EnProtection is set, err_o raises an error case (position variable",
            "mismatch)"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "err_o"
        }
      ],
      "localparams": [
        {
          "ptype": "unsigned",
          "name": "Width",
          "default": "InW + OutW"
        },
        {
          "ptype": "unsigned",
          "name": "ConcatW",
          "default": "Width + InW"
        },
        {
          "ptype": "unsigned",
          "name": "PtrW",
          "default": "$clog2(ConcatW+1)"
        },
        {
          "ptype": "unsigned",
          "name": "IdxW",
          "default": "prim_util_pkg::vbits(InW)"
        },
        {
          "ptype": "unsigned",
          "name": "OnesCntW",
          "default": "$clog2(InW+1)"
        }
      ]
    }
  ]
}