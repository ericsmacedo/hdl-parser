{
  "path": "$PRJ/tests/corpus/opentitan/prim_fifo_async.sv",
  "modules": [
    {
      "name": "prim_fifo_async",
      "params": [
        {
          "ptype": "unsigned",
          "name": "Width",
          "default": "16"
        },
        {
          "ptype": "unsigned",
          "name": "Depth",
          "default": "4"
        },
        {
          "ptype": "bit",
          "name": "OutputZeroIfEmpty",
          "default": "1'b0",
          "comment": [
            "if == 1 always output 0 when FIFO is empty"
          ]
        },
        {
          "ptype": "bit",
          "name": "OutputZeroIfInvalid",
          "default": "1'b0",
          "comment": [
            "if == 1 always output 0 when rvalid_o is low"
          ]
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_wr_i"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_wr_ni"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "wvalid_i"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "wready_o"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "wdata_i",
          "dim": "[Width-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "wdepth_o",
          "dim": "[DepthW-1:0]",
          "comment": [
            "read port"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_rd_i"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_rd_ni"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "rvalid_o"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rready_i"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "rdata_o",
          "dim": "[Width-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "rdepth_o",
          "dim": "[DepthW-1:0]"
        }
      ],
      "localparams": [
        {
          "ptype": "unsigned",
          "name": "DepthW",
          "default": "$clog2(Depth+1)",
          "comment": [
            "derived parameter representing [0..Depth]"
          ]
        },
        {
          "ptype": "unsigned",
          "name": "PTRV_W",
          "default": "(Depth == 1) ? 1 : $clog2(Depth)"
        },
        {
          "ptype": "unsigned",
          "name": "PTR_WIDTH",
          "default": "(Depth == 1) ? 1 : PTRV_W+1"
        }
      ]
    }
  ]
}