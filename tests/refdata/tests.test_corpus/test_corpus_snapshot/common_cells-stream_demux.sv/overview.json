      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "inp_valid_i"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "inp_ready_o"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "oup_sel_i",
          "dim": "[LOG_N_OUP-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "oup_valid_o",
          "dim": "[N_OUP-1:0]"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "oup_ready_i",
          "dim": "[N_OUP-1:0]"
        }
      ]
    }
  ]
}