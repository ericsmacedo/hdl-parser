            "/ Dependent parameters, DO NOT OVERRIDE!"
          ]
        },
        {
          "ptype": "unsigned",
          "name": "LOG_N_OUP",
          "default": "(N_OUP > 32'd1) ? unsigned'($clog2(N_OUP)) : 1'b1"
