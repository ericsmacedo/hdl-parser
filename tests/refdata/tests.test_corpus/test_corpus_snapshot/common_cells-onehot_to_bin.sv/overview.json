{
  "path": "$PRJ/tests/corpus/common_cells/onehot_to_bin.sv",
  "modules": [
    {
      "name": "onehot_to_bin",
      "params": [
        {
          "ptype": "unsigned",
          "name": "ONEHOT_WIDTH",
          "default": "16",
          "comment": [
            "Do Not Change"
          ]
        },
        {
          "ptype": "unsigned",
          "name": "BIN_WIDTH",
          "default": "ONEHOT_WIDTH == 1 ? 1 : $clog2(ONEHOT_WIDTH)"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "onehot",
          "dim": "[ONEHOT_WIDTH-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "bin",
          "dim": "[BIN_WIDTH-1:0]"
        }
      ]
    }
  ]
}