{
  "path": "$PRJ/tests/corpus/axi/axi_err_slv.sv",
  "modules": [
    {
      "name": "axi_err_slv",
      "params": [
        {
          "ptype": "unsigned",
          "name": "AxiIdWidth",
          "default": "0",
          "comment": [
            "AXI ID Width"
          ]
        },
        {
          "ptype": "type",
          "name": "axi_req_t",
          "default": "logic",
          "comment": [
            "AXI 4 request struct, with atop field"
          ]
        },
        {
          "ptype": "type",
          "name": "axi_resp_t",
          "default": "logic",
          "comment": [
            "AXI 4 response struct"
          ]
        },
        {
          "name": "axi_pkg"
        },
        {
          "ptype": "unsigned",
          "name": "RespWidth",
          "default": "32'd64",
          "comment": [
            "Data response width, gets zero extended or truncated to r.data."
          ]
        },
        {
          "ptype": "logic",
          "name": "RespData",
          "dim": "[RespWidth-1:0]",
          "default": "64'hCA11AB1EBADCAB1E",
          "comment": [
            "Hexvalue for data return value"
          ]
        },
        {
          "ptype": "bit",
          "name": "ATOPs",
          "default": "1'b1",
          "comment": [
            "Activate support for ATOPs.  Set to 1 if this slave could ever get an atomic AXI transaction."
          ]
        },
        {
          "ptype": "unsigned",
          "name": "MaxTrans",
          "default": "1",
          "comment": [
            "Maximum # of accepted transactions before stalling"
          ]
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_i",
          "comment": [
            "Clock"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_ni",
          "comment": [
            "Asynchronous reset active low"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "test_i",
          "comment": [
            "Testmode enable",
            "slave port"
          ]
        },
        {
          "direction": "input",
          "name": "axi_req_t"
        },
        {
          "direction": "input",
          "name": "slv_req_i"
        },
        {
          "direction": "output",
          "name": "axi_resp_t"
        },
        {
          "direction": "output",
          "name": "slv_resp_o"
        }
      ]
    }
  ]
}