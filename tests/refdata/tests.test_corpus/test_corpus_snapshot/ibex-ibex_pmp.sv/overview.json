{
  "path": "$PRJ/tests/corpus/ibex/ibex_pmp.sv",
  "modules": [
    {
      "name": "ibex_pmp",
      "params": [
        {
          "ptype": "unsigned",
          "name": "DmBaseAddr",
          "default": "32'h1A110000"
        },
        {
          "ptype": "unsigned",
          "name": "DmAddrMask",
          "default": "32'h00000FFF",
          "comment": [
            "Granularity of NAPOT access,",
            "0 = No restriction, 1 = 8 byte, 2 = 16 byte, 3 = 32 byte, etc."
          ]
        },
        {
          "ptype": "unsigned",
          "name": "PMPGranularity",
          "default": "0",
          "comment": [
            "Number of access channels (e.g. i-side + d-side)"
          ]
        },
        {
          "ptype": "unsigned",
          "name": "PMPNumChan",
          "default": "2",
          "comment": [
            "Number of implemented regions"
          ]
        },
        {
          "ptype": "unsigned",
          "name": "PMPNumRegions",
          "default": "4"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "name": "ibex_pkg"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "csr_pmp_addr_i",
          "dim": "[PMP_ADDR_MSB:0]",
          "dim_unpacked": "[PMPNumRegions]"
        },
        {
          "direction": "input",
          "name": "ibex_pkg"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "debug_mode_i"
        },
        {
          "direction": "input",
          "name": "ibex_pkg"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "pmp_req_addr_i",
          "dim": "[PMP_ADDR_MSB:0]",
          "dim_unpacked": "[PMPNumChan]"
        },
        {
          "direction": "input",
          "name": "ibex_pkg"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "pmp_req_err_o",
          "dim_unpacked": "[PMPNumChan]"
        }
      ]
    }
  ]
}