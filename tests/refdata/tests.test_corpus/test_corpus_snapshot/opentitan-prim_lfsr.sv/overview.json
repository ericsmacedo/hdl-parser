        },
        {
          "ptype": "logic",
          "name": "DefaultSeedLocal",
          "dim": "[LfsrDw-1:0]",
          "default": "DefaultSeed",
          "ifdefs": [
            "SIMULATION",
            "VERILATOR"
          ]
        }
      ]
    }
  ]
}