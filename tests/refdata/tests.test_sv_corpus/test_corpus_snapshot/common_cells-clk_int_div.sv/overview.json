            {
              "edge": "negedge",
              "signal": "rst_ni"
            }
          ],
          "clock": "clk_i",
          "clock_edge": "negedge",
          "reset": "rst_ni",
          "reset_edge": "negedge",
          "comment": [
            "The second flip-flop is required for odd integer division and needs to",
            "negative edge tirggered."
          ],
          "loc": {
