{
  "path": "$PRJ/tests/corpus/sv/common_cells/counter.sv",
  "modules": [
    {
      "name": "counter",
      "params": [
        {
          "ptype": "int",
          "name": "WIDTH",
          "default": "4"
        },
        {
          "ptype": "bit",
          "name": "STICKY_OVERFLOW",
          "default": "1'b0"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_i"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_ni"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clear_i",
          "comment": [
            "synchronous clear"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "en_i",
          "comment": [
            "enable the counter"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "load_i",
          "comment": [
            "load a new value"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "down_i",
          "comment": [
            "downcount, default is up"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "d_i",
          "dim": "[WIDTH-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "q_o",
          "dim": "[WIDTH-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "overflow_o"
        }
      ],
      "insts": [
        {
          "name": "i_counter",
          "module": "delta_counter",
          "connections": [
            {
              "port": "clk_i",
              "con": "clk_i"
            },
            {
              "port": "rst_ni",
              "con": "rst_ni"
            },
            {
              "port": "clear_i",
              "con": "clear_i"
            },
            {
              "port": "en_i",
              "con": "en_i"
            },
            {
              "port": "load_i",
              "con": "load_i"
            },
            {
              "port": "down_i",
              "con": "down_i"
            },
            {
              "port": "delta_i",
              "con": "{{WIDTH-1{1'b0}}, 1'b1}"
            },
            {
              "port": "d_i",
              "con": "d_i"
            },
            {
              "port": "q_o",
              "con": "q_o"
            },
            {
              "port": "overflow_o",
              "con": "overflow_o"
            }
          ]
        }
      ]
    }
  ]
}