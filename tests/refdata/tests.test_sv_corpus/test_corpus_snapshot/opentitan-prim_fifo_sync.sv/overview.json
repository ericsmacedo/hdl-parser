          "comment": [
            "if == 1 always output 0 when FIFO is empty"
          ]
        },
        {
          "ptype": "bit",
          "name": "Secure",
          "default": "1'b0",
          "comment": [
            "use prim count for pointers",
            "derived parameter"
          ]
        }
      ],
      "ports": [
        {
          "direction": "input",
          "name": "clk_i"
        },
        {
          "direction": "input",
          "name": "rst_ni",
          "comment": [
            "synchronous clear / flush port"
          ]
        },
        {
          "direction": "input",
          "name": "clr_i",
          "comment": [
            "write port"
          ]
        },
        {
          "direction": "input",
          "name": "wvalid_i"
        },
        {
          "direction": "output",
          "name": "wready_o"
        },
        {
          "direction": "input",
