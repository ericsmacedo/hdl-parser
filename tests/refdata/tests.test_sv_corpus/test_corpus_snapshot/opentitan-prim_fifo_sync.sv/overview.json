          ]
        },
        {
          "direction": "output",
          "name": "rvalid_o"
        },
        {
          "direction": "input",
          "name": "rready_i"
        },
        {
          "direction": "output",
          "name": "rdata_o",
          "dim": "[Width-1:0]",
          "comment": [
            "occupancy"
          ]
        },
        {
          "direction": "output",
          "name": "full_o"
        },
        {
          "direction": "output",
          "name": "depth_o",
          "dim": "[DepthW-1:0]"
        },
        {
          "direction": "output",
          "name": "err_o"
        }
      ],
      "localparams": [
        {
          "ptype": "int",
          "name": "DepthW",
          "default": "prim_util_pkg::vbits(Depth+1)"
