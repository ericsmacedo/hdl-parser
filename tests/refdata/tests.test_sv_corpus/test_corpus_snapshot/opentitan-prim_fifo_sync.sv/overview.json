{
  "path": "$PRJ/tests/corpus/sv/opentitan/prim_fifo_sync.sv",
  "modules": [
    {
      "name": "prim_fifo_sync",
      "params": [
        {
          "ptype": "int",
          "name": "Width",
          "default": "16"
        },
        {
          "ptype": "bit",
          "name": "Pass",
          "default": "1'b1",
          "comment": [
            "if == 1 allow requests to pass through empty FIFO"
          ]
