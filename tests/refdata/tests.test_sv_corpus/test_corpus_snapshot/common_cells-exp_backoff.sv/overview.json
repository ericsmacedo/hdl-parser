{
  "path": "$PRJ/tests/corpus/sv/common_cells/exp_backoff.sv",
  "modules": [
    {
      "name": "exp_backoff",
      "params": [
        {
          "ptype": "int",
          "name": "Seed",
          "default": "'hffff",
          "comment": [
            "/ 2**MaxExp-1 determines the maximum range from which random wait counts are drawn"
          ]
        },
        {
          "ptype": "int",
          "name": "MaxExp",
          "default": "16"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_i"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_ni",
          "comment": [
            "/ Sets the backoff counter (pulse) -> use when trial did not succeed"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "set_i",
          "comment": [
            "/ Clears the backoff counter (pulse) -> use when trial succeeded"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clr_i",
          "comment": [
            "/ Indicates whether the backoff counter is equal to zero and a new trial can be launched"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "is_zero_o"
        }
      ],
      "localparams": [
        {
          "ptype": "int",
          "name": "WIDTH",
          "default": "16"
        }
      ]
    }
  ]
}