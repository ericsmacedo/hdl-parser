{
  "path": "$PRJ/examples/sv/macro_ports.sv",
  "modules": [
    {
      "name": "macro_ports",
      "params": [
        {
          "ptype": "int",
          "name": "IN_WIDTH",
          "default": "16"
        },
        {
          "ptype": "int",
          "name": "OUT_WIDTH",
          "default": "8"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk_i",
          "comment": [
            "Clock"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "rst_ni",
          "comment": [
            "Reset, low active"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "in_valid"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "in_data",
          "dim": "[IN_WIDTH-1:0]"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "in_ready"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "out_valid"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "out_data",
          "dim": "[8-1:0]"
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "out_ready"
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "busy_o",
          "comment": [
            "Busy"
          ]
        }
      ]
    }
  ]
}