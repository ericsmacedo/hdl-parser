{
  "path": "$PRJ/examples/sv/comments_attributes.sv",
  "modules": [
    {
      "name": "comments_attributes",
      "params": [
        {
          "ptype": "int",
          "name": "WIDTH",
          "default": "8",
          "comment": [
            "inline block"
          ]
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "logic",
          "name": "clk",
          "comment": [
            "line comment"
          ]
        },
        {
          "direction": "input",
          "ptype": "logic",
          "name": "d",
          "dim": "[WIDTH-1:0]",
          "comment": [
            "block comment after port",
            "multi-line",
            "comment"
          ]
        },
        {
          "direction": "output",
          "ptype": "logic",
          "name": "q",
          "dim": "[WIDTH-1:0]"
        }
      ]
    }
  ]
}