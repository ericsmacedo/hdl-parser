{
  "path": "$PRJ/examples/vhdl/generics.vhd",
  "modules": [
    {
      "name": "generics",
      "params": [
        {
          "name": "WIDTH"
        },
        {
          "name": "DEPTH",
          "default": "16",
          "comment": [
            "-- Constrained integer"
          ]
        },
        {
          "name": "RESET_VAL",
          "dim": "[7:0]",
          "default": "(others => '0')",
          "comment": [
            "-- Vector with aggregate"
          ]
        },
        {
          "name": "NAME",
          "default": "\"fifo\"",
          "comment": [
            "-- String"
          ]
        },
        {
          "name": "SIM",
          "default": "false",
          "comment": [
            "-- Two generics in one declaration"
          ]
        },
        {
          "name": "DEBUG",
          "default": "false",
          "comment": [
            "-- Two generics in one declaration"
          ]
        },
        {
          "ptype": "constant",
          "name": "TIMEOUT",
          "default": "10 ns",
          "comment": [
            "-- Explicit object class"
          ]
        }
      ],
      "ports": [
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "clk"
        },
        {
          "direction": "in",
          "dtype": "std_logic_vector",
          "name": "din",
          "dim": "[WIDTH - 1:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "dout",
          "dim": "[WIDTH - 1:0]"
        }
      ]
    }
  ]
}