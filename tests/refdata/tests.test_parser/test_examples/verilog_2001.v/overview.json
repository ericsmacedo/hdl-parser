{
  "path": "$PRJ/examples/sv/verilog_2001.v",
  "modules": [
    {
      "name": "verilog_2001",
      "params": [
        {
          "name": "WIDTH",
          "default": "`WIDTH"
        }
      ],
      "ports": [
        {
          "direction": "input",
          "ptype": "wire",
          "name": "clk"
        },
        {
          "direction": "input",
          "ptype": "wire",
          "name": "din",
          "dim": "[WIDTH-1:0]"
        },
        {
          "direction": "output",
          "ptype": "reg",
          "name": "dout",
          "dim": "[WIDTH-1:0]"
        }
      ]
    }
  ]
}