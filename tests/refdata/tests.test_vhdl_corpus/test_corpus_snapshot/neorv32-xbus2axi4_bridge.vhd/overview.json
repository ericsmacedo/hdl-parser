          "dtype": "std_logic",
          "name": "m_axi_wlast"
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "m_axi_wvalid"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "m_axi_wready",
          "comment": [
            "-- AXI4 host read address channel --"
          ]
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_araddr",
          "dim": "[31:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_arlen",
          "dim": "[7:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_arsize",
          "dim": "[2:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
