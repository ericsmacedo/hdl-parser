        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_arcache",
          "dim": "[3:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_arprot",
          "dim": "[2:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "m_axi_arvalid"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "m_axi_arready",
          "comment": [
            "-- AXI4 host read data channel --"
          ]
        },
        {
          "direction": "in",
          "dtype": "std_logic_vector",
          "name": "m_axi_rdata",
          "dim": "[31:0]"
