          "dim": "[1:0]"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "m_axi_rlast"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "m_axi_rvalid"
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "m_axi_rready",
          "comment": [
            "-- AXI4 host write response channel --"
          ]
        },
        {
          "direction": "in",
          "dtype": "std_logic_vector",
          "name": "m_axi_bresp",
          "dim": "[1:0]"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "m_axi_bvalid"
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "m_axi_bready"
        }
      ],
      "insts": [
        {
          "name": "data_buffer_inst",
          "module": "neorv32_prim_fifo",
          "connections": [
            {
              "port": "clk_i",
              "con": "clk"
            },
            {
              "port": "rstn_i",
              "con": "resetn"
            },
            {
              "port": "clear_i",
              "con": "fifo.clr"
            },
            {
              "port": "level_o",
              "con": "open",
              "comment": [
                "-- write port --"
              ]
            },
            {
              "port": "wdata_i",
              "con": "fifo.wdata"
            },
            {
              "port": "we_i",
              "con": "fifo.we"
            },
            {
              "port": "free_o",
              "con": "open",
              "comment": [
                "-- read port --"
              ]
            },
            {
              "port": "re_i",
              "con": "fifo.re"
            },
            {
              "port": "rdata_o",
              "con": "fifo.rdata"
            },
            {
              "port": "avail_o",
              "con": "fifo.avail"
            }
