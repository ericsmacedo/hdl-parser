{
  "path": "$PRJ/tests/corpus/vhdl/neorv32/xbus2axi4_bridge.vhd",
  "modules": [
    {
      "name": "xbus2axi4_bridge",
      "params": [
        {
          "name": "BURST_EN",
          "comment": [
            "-- enable burst transfers"
          ]
        },
        {
          "name": "BURST_LEN",
          "comment": [
            "-- bytes per burst, has to be a multiple of 4"
          ]
        }
      ],
      "ports": [
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "clk"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "resetn",
          "comment": [
            "-- XBUS device interface --"
          ]
        },
        {
          "direction": "in",
          "dtype": "xbus_req_t",
          "name": "xbus_req_i"
        },
        {
          "direction": "out",
          "dtype": "xbus_rsp_t",
          "name": "xbus_rsp_o",
          "comment": [
            "-- AXI4 host write address channel --"
          ]
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_awaddr",
          "dim": "[31:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_awlen",
          "dim": "[7:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_awsize",
          "dim": "[2:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_awburst",
          "dim": "[1:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_awcache",
          "dim": "[3:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_awprot",
          "dim": "[2:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "m_axi_awvalid"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "m_axi_awready",
          "comment": [
            "-- AXI4 host write data channel --"
          ]
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "m_axi_wdata",
          "dim": "[31:0]"
