{
  "path": "$PRJ/tests/corpus/vhdl/potato/pp_fifo.vhd",
  "modules": [
    {
      "name": "pp_fifo",
      "params": [
        {
          "name": "DEPTH",
          "default": "64"
        },
        {
          "name": "WIDTH",
          "default": "32"
        }
      ],
      "ports": [
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "clk"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "reset",
          "comment": [
            "-- Status lines:"
          ]
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "full"
        },
        {
          "direction": "out",
          "dtype": "std_logic",
          "name": "empty",
          "comment": [
            "-- Data in:"
          ]
        },
        {
          "direction": "in",
          "dtype": "std_logic_vector",
          "name": "data_in",
          "dim": "[WIDTH - 1:0]"
        },
        {
          "direction": "out",
          "dtype": "std_logic_vector",
          "name": "data_out",
          "dim": "[WIDTH - 1:0]"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "push"
        },
        {
          "direction": "in",
          "dtype": "std_logic",
          "name": "pop"
        }
      ]
    }
  ]
}